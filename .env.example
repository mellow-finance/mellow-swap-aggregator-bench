# Copy to .env (gitignored) or point BENCH_ENV_FILE to an existing env file. Process env vars override these.

# Ethereum RPC with eth_simulateV1 and eth_createAccessList (debug_traceCall for debug_route.py)
ETH_RPC=
# only for discover_modules.py
PLASMA_RPC=
MANTLE_RPC=
ROBIN_RPC=
# Etherscan v2 multichain key: logs, tx lists
ETHERSCAN_API_KEY=
# hosted Fynd API key (Telegram bot @fynd_portal_bot)
FYND_API_KEY=
# 0x dashboard key; optional, 0x is skipped without it
ZERO_X_API_KEY=
